# Database (Neon PostgreSQL — create a separate Neon project for Milo)
DATABASE_URL=

# Server
PORT=5000
NODE_ENV=development

# Milo's own secret — independent, does not need to match FinanceTracker or KitchenPlanner.
# Milo has its own login (own users table, own OTP flow); other apps' data is only read via
# the explicit, consent-based Connected Apps flow, never a shared identity.
JWT_SECRET=

# Anthropic (Claude-powered digest + quick-add)
ANTHROPIC_API_KEY=

# OpenWeatherMap (Dashboard weather line) — free tier key from openweathermap.org/api
WEATHER_API_KEY=

# FinanceTracker cross-link (read-only, once connected via Connected Apps) — FinanceTracker's
# own DATABASE_URL
FINANCE_DATABASE_URL=

# Shared secret with FinanceTracker's /api/integrations/milo/bills-summary endpoint — must
# equal FinanceTracker's own MILO_INTEGRATION_KEY value exactly.
FINANCE_INTEGRATION_KEY=

# KitchenPlanner cross-link (read-only, once connected via Connected Apps) — KitchenPlanner's
# own DATABASE_URL
KITCHEN_DATABASE_URL=

# EmailJS (sends Milo's own login OTP email — "Milo One Time Password" template)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
