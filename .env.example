# Database (Neon PostgreSQL — create a separate Neon project for Milo)
DATABASE_URL=

# Server
PORT=5000
NODE_ENV=development

# Must equal FinanceTracker's SESSION_SECRET (not a JWT_SECRET — FinanceTracker's own Render
# deployment doesn't set one, and its jwtService.ts falls back to SESSION_SECRET for signing).
# Login happens against FinanceTracker (shared identity), this backend only verifies the token.
JWT_SECRET=

# Anthropic (Claude-powered digest + quick-add)
ANTHROPIC_API_KEY=

# FinanceTracker cross-link (read-only) — FinanceTracker's own DATABASE_URL
FINANCE_DATABASE_URL=

# KitchenPlanner cross-link (read-only) — KitchenPlanner's own DATABASE_URL
KITCHEN_DATABASE_URL=

# EmailJS (sends the FinanceTracker link OTP email)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
