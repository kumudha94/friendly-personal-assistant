{
  "expo": {
    "name": "Milo",
    "slug": "assistantmilo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#030e32"
    },
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.kumudha94.milo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030e32"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "474dffb7-c0bd-439f-8ae0-706b5e473d77"
      }
    },
    "owner": "glorykumudha"
  }
}
